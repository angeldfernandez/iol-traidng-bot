# Credenciales de tu cuenta real de IOL. IMPORTANTE: la API de IOL no tiene un entorno de pruebas
# separado (ni sandbox por API, ni la Cuenta de practica del Simulador es alcanzable por API -
# IOL confirma que esa cuenta "no esta vinculada a tu usuario ni a los servicios de API"). Esto
# significa que la API SIEMPRE opera tu cuenta real. No existe forma de probar Comprar/Vender con
# dinero falso a traves del bot.
IOL_USERNAME=
IOL_PASSWORD=

# Opcional: casi nunca hace falta. Solo si IOL te confirma una URL de API distinta a la default.
# IOL_BASE_URL_OVERRIDE=

# --- Los unicos dos interruptores que permiten enviar ordenes reales ---
# Hacen falta AMBOS en true/false segun corresponda para que el bot opere con dinero real.
# Con cualquiera de los dos en su valor "seguro", el bot corre en modo simulado igual.

# true (default) = el bot calcula todo pero NO envia ordenes reales, solo las loguea en logs/trades.csv
DRY_RUN=true
# Segunda confirmacion explicita, independiente de DRY_RUN, para evitar que un typo active el modo real.
# Dejalo en false hasta que hayas revisado a fondo logs/trades.csv en DRY_RUN y entiendas el riesgo.
CONFIRM_LIVE_TRADING=false

# --- Limites de riesgo (obligatorios para poder emitir una orden) ---
# Monto maximo por operacion individual, como % de la cartera total (NO son ARS fijos). Por
# defecto iguala al tope de exposicion por simbolo de abajo, asi una sola orden puede llegar a
# usar toda la exposicion permitida para ese simbolo. A diferencia de un monto fijo en ARS, esto
# escala solo con el tamano de la cartera y no deja afuera instrumentos caros sin querer.
MAX_MONTO_POR_ORDEN_PCT=20
# Porcentaje maximo de la cartera total que puede quedar expuesto a un solo simbolo.
MAX_EXPOSICION_POR_SIMBOLO_PCT=20
# Porcentaje MAXIMO de la cartera total que puede quedar invertido en SIMULTANEO, sumando todas
# las posiciones abiertas. Sin esto, varias senales de compra validas el mismo ciclo pueden
# desplegar casi el 100% del capital de una sola vez, sin colchon de cash. Con 80%, siempre queda
# al menos 20% disponible.
MAX_EXPOSICION_TOTAL_PCT=80
# Si la perdida acumulada del dia supera este porcentaje de la cartera, el bot deja de operar por el resto del dia.
MAX_PERDIDA_DIARIA_PCT=5

# --- Rotacion de posiciones (opcional, apagada por defecto) ---
# Si una senal de compra valida no consigue margen, vender la posicion mas debil ya abierta (nunca
# en perdida) para financiarla, siempre que el candidato nuevo la supere en score del ranking por
# al menos MIN_MEJORA_SCORE_ROTACION puntos. Depende del motor de ranking (score_total del dia) y
# no se puede backtestear retroactivamente -- dejar en false hasta validarlo en paper trading.
ROTACION_HABILITADA=false
MIN_MEJORA_SCORE_ROTACION=15
# Minutos que un simbolo vendido por rotacion queda sin poder recomprarse. Sin esto, si su propia
# senal tecnica sigue en BUY apenas se libera cash, puede volver a entrar y quedar otra vez como
# candidato a rotar en el ciclo siguiente -- compra/venta en bucle sin ganancia real (caso real:
# IVV comprado/vendido 5 veces en 3hs el 2026-08-14 por una oscilacion de score contra AMGN).
ROTACION_COOLDOWN_MINUTOS=60

# --- Toma de ganancia / stop-loss por posicion ---
# Atados al precio de compra de CADA posicion (no a senales de mercado): si una posicion ya tiene
# esta ganancia o perdida %, se vende sin importar lo que diga la estrategia. Ademas, mientras haya
# posicion abierta en un simbolo, el bot no compra mas de lo mismo aunque la senal siga en BUY.
#
# Un stop-loss muy ajustado (ej. 5%) puede saltar por ruido normal de precio en vez de una reversion
# real de tendencia, generando operaciones de mas y comiendose el resultado en costos. Antes de fijar
# estos valores para tu propio universo de simbolos, backtestealos con scripts/run_backtest.py
# (ver config/backtest.yaml) en vez de copiar un numero de otro lado.
TAKE_PROFIT_PCT=15
STOP_LOSS_PCT=10

# --- Universo de mercado a analizar ---
# En vez de una lista fija de simbolos, el bot escanea paneles completos de IOL (una llamada HTTP
# por panel) y despues se queda con los MAX_SIMBOLOS_A_ANALIZAR de mayor volumen operado en pesos.
# Paneles disponibles hoy: merval (~20 blue chips AR), burcap (~25, panel general AR),
# cedears (~920 CEDEARs). Separados por coma.
PANELES=merval,burcap,cedears

# Cuantos simbolos (los de mayor volumen, ya deduplicados entre paneles) se analizan a fondo cada
# ciclo (bajar serie historica + calcular indicadores). El bot cachea el historico localmente
# (cache/) y solo pide serie_historica de nuevo en el primer ciclo del dia por simbolo; despues
# actualiza con el precio que ya trae gratis el scan de paneles. Aun asi, subir mucho este numero
# sube el costo del primer ciclo de cada dia. Ver seccion "Costo de la API" del README.
MAX_SIMBOLOS_A_ANALIZAR=50

# Intervalo en minutos entre cada ciclo de analisis del loop principal.
LOOP_INTERVAL_MINUTES=15

# BYMA abre a las 10:30 (is_market_open, iol_bot/main.py), pero esa primera media hora sincroniza
# contra la apertura de Wall Street y puede traer precios/spreads mas ruidosos de lo normal. Este
# umbral separa "el mercado ya esta abierto" (dashboard, circuit breaker) de "el bot ya puede
# empezar a operar" -- formato HH:MM.
TRADING_START_TIME=11:00

# Cash inicial de la cartera virtual de scripts/paper_trade.py (paper trading). No afecta a
# iol_bot.main ni a tu cuenta real.
PAPER_INITIAL_CASH=100000
